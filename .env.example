NEXT_PUBLIC_WA_NUMBER=
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Google Analytics 4 measurement ID. Optional — the production property
# (G-GQH6EWMLDZ) is the hardcoded default in
# src/components/analytics/GoogleAnalytics.tsx. Set this only to point a
# deploy at a different property. The tag never loads outside NODE_ENV=production.
NEXT_PUBLIC_GA_ID=

# GA4 Data API — feeds the Analytics tab in /studio via /api/analytics.
# Server-only (never NEXT_PUBLIC_). Setup: docs/deploy-coolify.md §3a.
# GA_PROPERTY_ID is the numeric property ID (GA Admin → Property details),
# not the G-… measurement ID. Paste GA_PRIVATE_KEY on one line with literal \n.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_PRIVATE_KEY=

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=

# Resend (contact form emails) — https://resend.com
RESEND_API_KEY=
# From address. Without a verified domain, use "Ilot <onboarding@resend.dev>"
# (can only deliver to the email that owns the Resend account). Once a domain is
# verified, use an address on it, e.g. "Ilot <hello@ilotlegal.com>".
RESEND_FROM=
# Where contact-form notifications are delivered (the admin/owner inbox).
CONTACT_ADMIN_EMAIL=

# HubSpot CRM (contact form → Forms API). Not secret — both appear in any
# embedded HubSpot form. Portal/Hub ID + the published form's GUID.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# Survey intake modal (/?survey_intake_form=true) → Google Sheets.
# Deploy docs/survey-sheet-apps-script.gs as a web app from the receiving
# spreadsheet, then paste its deployment URL here. GSHEET_SECRET must match the
# SECRET constant inside that script, or every write is rejected.
# Both are required — without them the survey logs to console and stores nothing.
GSHEET_WEBHOOK_URL=
GSHEET_SECRET=
